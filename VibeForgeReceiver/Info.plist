<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>VibeForge Receiver</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- Local-network streaming over plain HTTP on the LAN -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>VibeForge Receiver finds your Mac on the local network to show its screen.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_vibeforge._tcp</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <!-- Apple's own docs on NSAllowsLocalNetworking are inconsistent about
             whether it alone still covers a typed IP literal (the "Connect by
             IP" fallback) on iOS/tvOS 17+, which tightened ATS's default IP
             handling. This is the belt-and-suspenders pairing Apple's own
             NSAllowsArbitraryLoads docs describe for exactly that ambiguity:
             newer OS versions honor NSAllowsLocalNetworking and ignore this
             key, older ones fall back to it. Every request this app makes
             still only ever goes to a Bonjour-discovered or user-typed LAN
             host -- this doesn't open a path to the public internet. -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
